    "Clean selects stale node_modules, artifacts of inactive projects and Safe caches." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يحدد «تنظيف» مجلدات node_modules المتقادمة ومخرجات بناء المشاريع غير النشطة والذاكرات المؤقتة الآمنة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Bereinigen“ wählt veraltete node_modules, Artefakte inaktiver Projekte und sichere Caches aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Limpiar selecciona node_modules obsoletos, artefactos de proyectos inactivos y cachés seguras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nettoyer sélectionne les node_modules dormants, les artefacts des projets inactifs et les caches sûrs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "״נקה״ בוחר node_modules נטושים, תוצרי בנייה של פרויקטים לא פעילים ומטמונים בטוחים."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "クリーンアップでは、長期未使用のnode_modules、非アクティブなプロジェクトのビルド生成物、安全なキャッシュを選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "정리는 오래된 node_modules, 비활성 프로젝트의 산출물, 안전 캐시를 선택합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Limpar seleciona node_modules obsoletos, artefatos de projetos inativos e caches Seguros."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“清理”会选择闲置的 node_modules、非活跃项目的构建产物以及安全缓存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「清理」會選取閒置的 node_modules、非使用中專案的建置產物，以及安全的快取。"
          }
        }
      }
    },
