    "Compares files over 1 MB in your big-file locations (Settings → Big file locations). This reads the files, so it can take a while." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يقارن الملفات الأكبر من 1 MB في مواقع الملفات الكبيرة (الإعدادات ← مواقع الملفات الكبيرة). يقرأ ذلك الملفات، لذا قد يستغرق بعض الوقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vergleicht Dateien über 1 MB in Ihren Orten für große Dateien (Einstellungen → Orte für große Dateien). Dabei werden die Dateien gelesen, das kann dauern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compara archivos de más de 1 MB en tus ubicaciones de archivos grandes (Ajustes → Ubicaciones de archivos grandes). Lee los archivos, así que puede tardar un rato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compare les fichiers de plus de 1 Mo dans vos emplacements de gros fichiers (Réglages → Emplacements des gros fichiers). Les fichiers sont lus, cela peut donc prendre du temps."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "משווה קבצים מעל 1 MB במיקומי הקבצים הגדולים שלך (הגדרות ← מיקומים לקבצים גדולים). זה קורא את הקבצים, ולכן עשוי לקחת זמן."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "大きなファイルの場所（設定 → 大きなファイルの場所）にある1 MBを超えるファイルを比較します。ファイルを読み込むため、時間がかかることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "대용량 파일 위치(설정 → 대용량 파일 위치)에서 1MB가 넘는 파일을 비교합니다. 파일을 읽으므로 시간이 걸릴 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compara arquivos acima de 1 MB nos seus locais de arquivos grandes (Ajustes → Locais de arquivos grandes). Isso lê os arquivos, então pode demorar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "比较大文件位置（设置 → 大文件位置）中超过 1 MB 的文件。这需要读取文件内容，可能需要一段时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "比較大型檔案位置中超過 1 MB 的檔案（設定 → 大型檔案位置）。這會讀取檔案，可能需要一段時間。"
          }
        }
      }
    },
