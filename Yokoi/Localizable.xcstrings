    "Run a scan to measure npm, Yarn, pnpm, Homebrew, CocoaPods, pip, Cargo, Xcode, Android and browser caches." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "شغّل فحصًا لقياس ذاكرات npm وYarn وpnpm وHomebrew وCocoaPods وpip وCargo وXcode وAndroid والمتصفحات المؤقتة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Führen Sie einen Scan durch, um npm-, Yarn-, pnpm-, Homebrew-, CocoaPods-, pip-, Cargo-, Xcode-, Android- und Browser-Caches zu messen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Haz un análisis para medir las cachés de npm, Yarn, pnpm, Homebrew, CocoaPods, pip, Cargo, Xcode, Android y los navegadores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lancez une analyse pour mesurer les caches npm, Yarn, pnpm, Homebrew, CocoaPods, pip, Cargo, Xcode, Android et des navigateurs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הרץ סריקה כדי למדוד את המטמונים של npm, ‏Yarn, ‏pnpm, ‏Homebrew, ‏CocoaPods, ‏pip, ‏Cargo, ‏Xcode, ‏Android והדפדפנים."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "スキャンを実行して、npm、Yarn、pnpm、Homebrew、CocoaPods、pip、Cargo、Xcode、Android、ブラウザのキャッシュを計測します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "스캔을 실행하여 npm, Yarn, pnpm, Homebrew, CocoaPods, pip, Cargo, Xcode, Android 및 브라우저 캐시를 측정하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faça uma análise para medir os caches de npm, Yarn, pnpm, Homebrew, CocoaPods, pip, Cargo, Xcode, Android e navegadores."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "运行扫描以测量 npm、Yarn、pnpm、Homebrew、CocoaPods、pip、Cargo、Xcode、Android 和浏览器缓存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "執行掃描以測量 npm、Yarn、pnpm、Homebrew、CocoaPods、pip、Cargo、Xcode、Android 和瀏覽器快取。"
          }
        }
      }
    },
    "Run it in Terminal yourself: Yokoi never uses sudo. Shortcuts gets “Scan for Reclaimable Space”, “Get Free Disk Space” and “Open Yokoi”." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "شغّله في Terminal بنفسك: لا يستخدم Yokoi ‏sudo أبدًا. تحصل الاختصارات على «فحص المساحة القابلة للاسترداد» و«الحصول على مساحة القرص المتاحة» و«فتح Yokoi»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Führen Sie es selbst im Terminal aus: Yokoi verwendet nie sudo. Kurzbefehle erhält „Nach freigebbarem Speicher scannen“, „Freien Speicherplatz abfragen“ und „Yokoi öffnen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ejecútalo tú mismo en Terminal: Yokoi nunca usa sudo. Atajos incluye “Buscar espacio recuperable”, “Obtener espacio libre en disco” y “Abrir Yokoi”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lancez-la vous-même dans Terminal : Yokoi n’utilise jamais sudo. Raccourcis reçoit « Rechercher l’espace récupérable », « Obtenir l’espace disque libre » et « Ouvrir Yokoi »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הרץ את זה ב-Terminal בעצמך: Yokoi אף פעם לא משתמש ב-sudo. ב״קיצורים״ יש את ״סרוק לאיתור שטח שניתן לפנות״, ״קבל שטח פנוי בדיסק״ ו״פתח את Yokoi״."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ターミナルでご自身で実行してください：Yokoiはsudoを使用しません。ショートカットには「解放可能な容量をスキャン」「ディスクの空き容量を取得」「Yokoiを開く」が追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "터미널에서 직접 실행하십시오. Yokoi는 sudo를 사용하지 않습니다. 단축어에서 “확보 가능 공간 스캔”, “여유 디스크 공간 가져오기”, “Yokoi 열기”를 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Execute no Terminal você mesmo: o Yokoi nunca usa sudo. O Atalhos recebe “Analisar Espaço Recuperável”, “Obter Espaço Livre em Disco” e “Abrir o Yokoi”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "请自行在终端中运行：Yokoi 从不使用 sudo。快捷指令中可使用“扫描可回收空间”、“获取可用磁盘空间”和“打开 Yokoi”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "請自行在「終端機」中執行：Yokoi 從不使用 sudo。「捷徑」可使用「掃描可回收空間」、「取得可用磁碟空間」和「打開 Yokoi」。"
          }
        }
      }
    },
