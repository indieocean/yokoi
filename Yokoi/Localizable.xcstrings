    "Files you already deleted, not a cache. Emptying the Trash can't be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ملفات حذفتها بالفعل، وليست ذاكرة مؤقتة. لا يمكن التراجع عن إفراغ سلة المهملات."
          }
        },
        "de" : {
          "stringUnit" : {
