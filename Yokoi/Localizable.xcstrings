    "Shares storage with another file, so removing it frees less than its length" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يتشارك التخزين مع ملف آخر، لذا تحرر إزالته مساحة أقل من حجمه"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
