    "Volume data can't be put back. Check the list for databases you still need." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا يمكن إرجاع بيانات وحدات التخزين. تحقق من القائمة بحثًا عن قواعد بيانات لا تزال تحتاج إليها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volume-Daten können nicht zurückgelegt werden. Prüfen Sie die Liste auf Datenbanken, die Sie noch brauchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los datos de los volúmenes no se pueden recuperar. Revisa la lista por si hay bases de datos que aún necesites."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les données des volumes ne peuvent pas être remises. Vérifiez la liste pour les bases de données dont vous avez encore besoin."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "לא ניתן להחזיר נתוני אמצעי אחסון למקומם. בדוק ברשימה אם יש מסדי נתונים שעדיין נחוצים לך."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ボリュームのデータは戻せません。まだ必要なデータベースがないかリストを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "볼륨 데이터는 되돌려 놓을 수 없습니다. 아직 필요한 데이터베이스가 있는지 목록을 확인하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dados de volumes não podem ser devolvidos. Verifique a lista em busca de bancos de dados que ainda usa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "卷数据无法放回原处。请检查列表中是否有你仍需要的数据库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "卷宗資料無法放回原處。請檢查列表中是否有仍需要的資料庫。"
          }
        }
      }
    },
    "Volumes no container is attached to. They can hold database data, which is lost for good." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "وحدات تخزين غير مرتبطة بأي حاوية. قد تحتوي على بيانات قواعد بيانات تُفقد نهائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volumes, mit denen kein Container verbunden ist. Sie können Datenbankdaten enthalten, die dann endgültig verloren sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volúmenes sin ningún contenedor conectado. Pueden contener datos de bases de datos, que se pierden para siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volumes rattachés à aucun conteneur. Ils peuvent contenir des données de bases de données, perdues pour de bon."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "אמצעי אחסון שאף קונטיינר לא מחובר אליהם. הם עשויים להכיל נתוני מסדי נתונים, שאובדים לתמיד."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "どのコンテナにも接続されていないボリュームです。データベースのデータを含む場合があり、完全に失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "어떤 컨테이너에도 연결되지 않은 볼륨입니다. 데이터베이스 데이터가 들어 있을 수 있으며, 삭제하면 영구적으로 사라집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volumes sem nenhum contêiner associado. Podem conter dados de bancos de dados, que se perdem para sempre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "未挂接到任何容器的卷。它们可能包含数据库数据，删除后将永久丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "沒有連接任何容器的卷宗。其中可能存有資料庫資料，刪除後將永久遺失。"
          }
        }
      }
    },
