    "Build output. Some projects commit or publish dist/, so it's opt-in." : {
      "comment" : "Tooltip for an opt-in dist/ folder",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مخرجات البناء. بعض المشاريع تودع dist/ في المستودع أو تنشره، لذا يكون اختياريًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Build-Ausgabe. Manche Projekte committen oder veröffentlichen dist/, daher nur auf Wunsch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Resultado de la compilación. Algunos proyectos incluyen dist/ en el repositorio o lo publican, así que es opcional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
