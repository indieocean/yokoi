    "Every day, move screenshots older than %lld days to the Trash. Logged like any cleanup." : {
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "zero" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "كل يوم، تُنقل لقطات الشاشة الأقدم من %lld يوم إلى سلة المهملات. يُسجَّل ذلك مثل أي تنظيف."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "كل يوم، تُنقل لقطات الشاشة الأقدم من يوم واحد إلى سلة المهملات. يُسجَّل ذلك مثل أي تنظيف."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "كل يوم، تُنقل لقطات الشاشة الأقدم من يومين إلى سلة المهملات. يُسجَّل ذلك مثل أي تنظيف."
                }
              },
              "few" : {
