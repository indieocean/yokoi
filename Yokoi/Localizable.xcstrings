    "Yokoi looks in the folder macOS saves screenshots to. Change it in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يبحث Yokoi في المجلد الذي يحفظ فيه macOS لقطات الشاشة. غيّره في الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yokoi sucht in dem Ordner, in dem macOS Bildschirmfotos sichert. Ändern Sie ihn in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yokoi busca en la carpeta donde macOS guarda las capturas de pantalla. Cámbiala en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
