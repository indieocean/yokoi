    "Go has no uninstall command: delete the binary from your Go bin folder to remove a tool." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا يملك Go أمر إلغاء تثبيت: احذف الملف التنفيذي من مجلد bin الخاص بـ Go لإزالة أداة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Go hat keinen Deinstallationsbefehl: Löschen Sie die Binärdatei aus Ihrem Go-bin-Ordner, um ein Tool zu entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Go no tiene comando de desinstalación: elimina el binario de tu carpeta bin de Go para quitar una herramienta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Go n’a pas de commande de désinstallation : supprimez le binaire de votre dossier bin Go pour retirer un outil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ל-Go אין פקודת הסרה: כדי להסיר כלי, מחק את הקובץ הבינארי מתיקיית ה-bin של Go."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Goにはアンインストールコマンドがありません。ツールを削除するには、Goのbinフォルダからバイナリを削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Go에는 제거 명령이 없습니다. 도구를 제거하려면 Go bin 폴더에서 바이너리를 삭제하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Go não tem comando de desinstalação: apague o binário da pasta bin do Go para remover uma ferramenta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Go 没有卸载命令：要移除工具，请从 Go bin 文件夹中删除其二进制文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Go 沒有解除安裝指令：若要移除工具，請從 Go bin 檔案夾刪除其二進位檔。"
          }
        }
      }
    },
    "Go module cache" : {
      "comment" : "Tool cleanup row title",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ذاكرة وحدات Go المؤقتة"
          }
