          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yokoi מחפש בתיקייה שבה macOS שומר צילומי מסך. אפשר לשנות אותה בהגדרות."
          }
        },
        "ja" : {
          "stringUnit" : {
