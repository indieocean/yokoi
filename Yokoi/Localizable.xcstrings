            "state" : "needs_review",
            "value" : "تشمل الأحجام الطبقات التي تتشاركها الصور، لذا قد يتجاوز مجموع العناصر الإجمالي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Größen enthalten gemeinsam genutzte Layer, daher können einzelne Objekte zusammen mehr ergeben als die Gesamtsumme."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los tamaños incluyen capas que comparten las imágenes, así que los elementos sueltos pueden sumar más que el total."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les tailles incluent les couches partagées entre images, la somme des éléments peut donc dépasser le total."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הגדלים כוללים שכבות משותפות לכמה תמונות, ולכן סכום הפריטים עשוי לעלות על הסך הכולל."
