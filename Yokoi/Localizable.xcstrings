          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "크기에 이미지 간 공유 레이어가 포함되므로 개별 항목의 합이 전체보다 클 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os tamanhos incluem camadas compartilhadas entre imagens, então itens individuais podem somar mais que o total."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
