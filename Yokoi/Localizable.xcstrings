    "No two files over 1 MB in %@ have the same contents." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا يوجد ملفان أكبر من 1 MB في %@ لهما المحتوى نفسه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Keine zwei Dateien über 1 MB in %@ haben denselben Inhalt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No hay dos archivos de más de 1 MB en %@ con el mismo contenido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aucun fichier de plus de 1 Mo dans %@ n’a le même contenu qu’un autre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "אין ב-%@ שני קבצים מעל 1 MB עם תוכן זהה."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@内に、同じ内容の1 MBを超えるファイルはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@에 내용이 같은 1MB 초과 파일이 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nenhum par de arquivos acima de 1 MB em %@ tem o mesmo conteúdo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“%@”中没有内容相同的两个超过 1 MB 的文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 中沒有任何兩個超過 1 MB 的檔案內容相同。"
          }
        }
      }
    },
    "No two files over 1 MB in your big-file locations have the same contents. Copies that are all inside git repositories aren't listed: use Choose Folder to look through one." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا يوجد ملفان أكبر من 1 MB في مواقع الملفات الكبيرة لهما المحتوى نفسه. لا تظهر النسخ الموجودة كلها داخل مستودعات git: استخدم «اختيار مجلد» للبحث في أحدها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Keine zwei Dateien über 1 MB in Ihren Orten für große Dateien haben denselben Inhalt. Kopien, die alle in Git-Repositorys liegen, werden nicht aufgeführt: Mit „Ordner auswählen“ können Sie einen Ordner durchsuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No hay dos archivos de más de 1 MB en tus ubicaciones de archivos grandes con el mismo contenido. No se muestran las copias que están todas dentro de repositorios git: usa Elegir carpeta para buscar en una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aucun fichier de plus de 1 Mo dans vos emplacements de gros fichiers n’a le même contenu qu’un autre. Les copies toutes situées dans des dépôts git ne sont pas listées : utilisez Choisir un dossier pour en parcourir un."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "אין במיקומי הקבצים הגדולים שלך שני קבצים מעל 1 MB עם תוכן זהה. עותקים שכולם נמצאים בתוך מאגרי git לא מוצגים: השתמש ב״בחר תיקייה״ כדי לחפש בתיקייה אחת."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "大きなファイルの場所に、同じ内容の1 MBを超えるファイルはありません。すべてgitリポジトリ内にあるコピーは表示されません。1つのフォルダを検索するには「フォルダを選択」を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "대용량 파일 위치에 내용이 같은 1MB 초과 파일이 없습니다. 모두 git 저장소 안에 있는 사본은 표시되지 않습니다. 한 폴더를 살펴보려면 폴더 선택을 사용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nenhum par de arquivos acima de 1 MB nos seus locais de arquivos grandes tem o mesmo conteúdo. Cópias que estão todas dentro de repositórios git não aparecem: use Escolher Pasta para procurar em uma."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "大文件位置中没有内容相同的两个超过 1 MB 的文件。全部位于 git 仓库中的副本不会列出：使用“选择文件夹”可查找单个文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "大型檔案位置中沒有任何兩個超過 1 MB 的檔案內容相同。全都位於 git 儲存庫中的副本不會列出：請使用「選擇檔案夾」瀏覽單一檔案夾。"
          }
        }
      }
    },
