    "APFS snapshots macOS keeps between Time Machine backups. macOS frees them on its own when space runs low." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لقطات APFS يحتفظ بها macOS بين نسخ Time Machine الاحتياطية. يحررها macOS تلقائيًا عند انخفاض المساحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "APFS-Schnappschüsse, die macOS zwischen Time Machine-Backups behält. macOS gibt sie selbst frei, wenn der Speicherplatz knapp wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Instantáneas APFS que macOS guarda entre copias de seguridad de Time Machine. macOS las libera por sí solo cuando queda poco espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Instantanés APFS que macOS conserve entre les sauvegardes Time Machine. macOS les libère tout seul quand l’espace manque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "תמונות מצב של APFS ש-macOS שומר בין גיבויי Time Machine. macOS מפנה אותן בעצמו כשהמקום אוזל."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Time Machineバックアップの合間にmacOSが保持するAPFSスナップショットです。空き容量が少なくなると、macOSが自動的に解放します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS가 Time Machine 백업 사이에 보관하는 APFS 스냅샷입니다. 공간이 부족하면 macOS가 자동으로 해제합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Snapshots APFS que o macOS mantém entre backups do Time Machine. O macOS os libera sozinho quando falta espaço."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS 在两次 Time Machine 备份之间保留的 APFS 快照。空间不足时，macOS 会自动释放它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS 在 Time Machine 備份之間保留的 APFS 快照。空間不足時，macOS 會自動釋放。"
          }
        }
      }
    },
