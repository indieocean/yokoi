    "Picks every copy but the best one in each group, leaving copies in git repositories alone" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يحدد كل النسخ عدا أفضلها في كل مجموعة، ويترك النسخ الموجودة في مستودعات git"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wählt in jeder Gruppe alle Kopien außer der besten aus, Kopien in Git-Repositorys bleiben unberührt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elige todas las copias menos la mejor de cada grupo, sin tocar las copias de repositorios git"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Choisit toutes les copies sauf la meilleure de chaque groupe, sans toucher aux copies dans des dépôts git"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "בוחר כל עותק מלבד הטוב ביותר בכל קבוצה, בלי לגעת בעותקים שבמאגרי git"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "各グループで最適な1つを除くすべてのコピーを選択します。gitリポジトリ内のコピーはそのままにします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "각 그룹에서 가장 적합한 사본을 제외한 모든 사본을 선택하며, git 저장소 안의 사본은 그대로 둡니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Escolhe todas as cópias menos a melhor de cada grupo, sem tocar nas cópias em repositórios git"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在每组中选择除最佳副本外的所有副本，git 仓库中的副本不受影响"
