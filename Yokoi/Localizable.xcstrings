    "BuildKit layer cache. The next `docker build` is slower while it refills." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ذاكرة طبقات BuildKit المؤقتة. يكون `docker build` التالي أبطأ ريثما تمتلئ من جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "BuildKit-Layer-Cache. Der nächste `docker build` ist langsamer, bis er wieder gefüllt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Caché de capas de BuildKit. El próximo `docker build` es más lento mientras se rellena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cache des couches BuildKit. Le prochain `docker build` est plus lent le temps qu’il se remplisse."
