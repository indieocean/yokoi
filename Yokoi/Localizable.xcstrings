    "Simulators that use a deleted runtime stop booting until it's downloaded again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تتوقف أجهزة Simulator التي تستخدم بيئة تشغيل محذوفة عن الإقلاع حتى يُعاد تنزيلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Simulatoren, die eine gelöschte Runtime verwenden, starten erst wieder, wenn sie erneut geladen wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los simuladores que usan un runtime eliminado no arrancan hasta que se vuelve a descargar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les simulateurs qui utilisent un runtime supprimé ne démarrent plus tant qu’il n’est pas retéléchargé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "סימולטורים שמשתמשים בסביבת ריצה שנמחקה לא יאתחלו עד שהיא תורד שוב."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "削除したランタイムを使用するシミュレータは、再ダウンロードされるまで起動できなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "삭제된 런타임을 사용하는 시뮬레이터는 런타임을 다시 다운로드하기 전까지 부팅되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Simuladores que usam um runtime apagado deixam de iniciar até ele ser baixado de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
