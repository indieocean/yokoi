    "Only stale node_modules, artifacts of inactive projects and Safe caches. All of it can be rebuilt or re-downloaded." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "فقط مجلدات node_modules المتقادمة ومخرجات بناء المشاريع غير النشطة والذاكرات المؤقتة الآمنة. يمكن إعادة بناء كل ذلك أو إعادة تنزيله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nur veraltete node_modules, Artefakte inaktiver Projekte und sichere Caches. Alles davon kann neu erstellt oder erneut geladen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Solo node_modules obsoletos, artefactos de proyectos inactivos y cachés seguras. Todo se puede regenerar o volver a descargar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uniquement les node_modules dormants, les artefacts des projets inactifs et les caches sûrs. Tout peut être reconstruit ou retéléchargé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "רק node_modules נטושים, תוצרי בנייה של פרויקטים לא פעילים ומטמונים בטוחים. את כל אלה אפשר לבנות או להוריד מחדש."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "長期未使用のnode_modules、非アクティブなプロジェクトのビルド生成物、安全なキャッシュのみ。すべて再構築または再ダウンロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "오래된 node_modules, 비활성 프로젝트의 산출물, 안전 캐시만 해당합니다. 모두 다시 빌드하거나 다시 다운로드할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Só node_modules obsoletos, artefatos de projetos inativos e caches Seguros. Tudo pode ser recriado ou baixado de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "仅限闲置的 node_modules、非活跃项目的构建产物以及安全缓存。所有这些都可以重新构建或重新下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "僅限閒置的 node_modules、非使用中專案的建置產物和安全快取。全部都可以重新建置或重新下載。"
          }
        }
      }
    },
